digraph AWS_Architecture {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, labelloc=t, pad=0.4, nodesep=0.6, ranksep=0.9, splines=spline, newrank=true,
         label="Scalable Web Application with ALB and Auto Scaling (us-east-1)\n "];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.15,0.08", color="#37474F", fillcolor="#FFFFFF"];
  edge  [fontname="Helvetica", fontsize=9, color="#455A64", arrowsize=0.7];

  users [label="Users\n(Internet)", shape=ellipse, fillcolor="#ECEFF1"];

  subgraph cluster_edge {
    label="Edge and DNS (global)"; style="rounded,dashed"; color="#7E57C2"; fontcolor="#4527A0"; fontsize=11;
    r53 [label="Amazon Route 53\nalias: www to CloudFront, origin to ALB\n+ health checks", fillcolor="#EDE7F6"];
    cf  [label="Amazon CloudFront\nHTTPS, edge caching", fillcolor="#EDE7F6"];
    s3  [label="Amazon S3\nstatic assets (private, OAC)", fillcolor="#E8F5E9", color="#2E7D32"];
  }

  subgraph cluster_vpc {
    label="VPC 10.0.0.0/16"; style="rounded"; color="#1565C0"; fontcolor="#0D47A1"; fontsize=12; bgcolor="#F5F9FF";

    igw [label="Internet Gateway", fillcolor="#E3F2FD"];
    waf [label="AWS WAF\nOWASP Top 10 managed rules", fillcolor="#FFEBEE", color="#C62828"];
    alb [label="Application Load Balancer\n(internet-facing, both public subnets)\nHTTPS listener, health checks", fillcolor="#FFF3E0", color="#E65100"];

    subgraph cluster_az1 {
      label="Availability Zone A"; style="rounded,dashed"; color="#546E7A"; fontsize=11;
      subgraph cluster_pub1 { label="Public subnet 10.0.1.0/24"; style="rounded,filled"; fillcolor="#E8F5E9"; color="#66BB6A";
        nat1 [label="NAT Gateway A\n+ Elastic IP", fillcolor="#FFFFFF"]; }
      subgraph cluster_app1 { label="Private app subnet 10.0.11.0/24"; style="rounded,filled"; fillcolor="#E3F2FD"; color="#42A5F5";
        ec2a [label="EC2 web/app instances\n(Auto Scaling group)", fillcolor="#FFFFFF", color="#E65100"]; }
      subgraph cluster_db1 { label="Private data subnet 10.0.21.0/24"; style="rounded,filled"; fillcolor="#F3E5F5"; color="#AB47BC";
        rds1 [label="Amazon RDS\nPRIMARY", fillcolor="#FFFFFF", color="#283593"]; }
    }
    subgraph cluster_az2 {
      label="Availability Zone B"; style="rounded,dashed"; color="#546E7A"; fontsize=11;
      subgraph cluster_pub2 { label="Public subnet 10.0.2.0/24"; style="rounded,filled"; fillcolor="#E8F5E9"; color="#66BB6A";
        nat2 [label="NAT Gateway B\n+ Elastic IP", fillcolor="#FFFFFF"]; }
      subgraph cluster_app2 { label="Private app subnet 10.0.12.0/24"; style="rounded,filled"; fillcolor="#E3F2FD"; color="#42A5F5";
        ec2b [label="EC2 web/app instances\n(Auto Scaling group)", fillcolor="#FFFFFF", color="#E65100"]; }
      subgraph cluster_db2 { label="Private data subnet 10.0.22.0/24"; style="rounded,filled"; fillcolor="#F3E5F5"; color="#AB47BC";
        rds2 [label="Amazon RDS\nSTANDBY (Multi-AZ)", fillcolor="#FFFFFF", color="#283593"]; }
    }

    asg  [label="Auto Scaling Group\nLaunch Template, target tracking\n(CPU 50%, ALB requests/target)", fillcolor="#FFF8E1", color="#F9A825"];
    vpce [label="S3 Gateway\nVPC Endpoint", fillcolor="#E3F2FD"];
    ssm  [label="Systems Manager\nSession Manager (no bastion, no SSH)", fillcolor="#E0F2F1", color="#00695C"];
  }

  subgraph cluster_ops {
    label="Monitoring and secrets"; style="rounded,dashed"; color="#00897B"; fontcolor="#00695C"; fontsize=11;
    cw  [label="Amazon CloudWatch\ndashboards + alarms", fillcolor="#E0F2F1"];
    sns [label="Amazon SNS\nalarm notifications", fillcolor="#E0F2F1"];
    sm  [label="AWS Secrets Manager\nRDS credentials", fillcolor="#E0F2F1"];
  }

  users -> r53 [label="1. DNS lookup"];
  users -> cf  [label="2. HTTPS"];
  r53 -> cf    [style=dashed, label="alias: www"];
  cf -> s3     [label="static /assets/*"];
  cf -> igw    [label="dynamic requests (origin)"];
  igw -> alb;
  waf -> alb   [constraint=false, dir=none, color="#C62828", label="attached"];
  alb -> ec2a  [label="HTTP :80"];
  alb -> ec2b  [label="HTTP :80"];
  asg -> ec2a  [constraint=false, style=dashed, arrowhead=none, color="#F9A825"];
  ec2a -> rds1 [label="SQL :3306/5432"];
  ec2b -> rds1 [label="SQL"];
  rds1 -> rds2 [dir=both, color="#283593", label="synchronous replication\nautomatic failover"];
  ec2a -> nat1 [constraint=false, label="outbound only"];
  ec2b -> nat2 [constraint=false, label="outbound only"];
  nat1 -> igw  [constraint=false, style=dotted];
  nat2 -> igw  [constraint=false, style=dotted];
  ec2a -> vpce [constraint=false, style=dashed, label="S3 via private path"];
  ssm -> ec2a  [constraint=false, style=dashed, color="#00695C"];
  ec2b -> sm   [constraint=false, style=dashed, color="#00897B", label="DB credentials"];
  alb -> cw    [constraint=false, style=dashed, color="#00897B", label="metrics: ALB, EC2, RDS"];
  cw -> sns    [color="#00897B", label="alarm"];

  { rank=same; alb; nat1; nat2; waf; }
  { rank=same; ec2a; ec2b; asg; ssm; }
  { rank=same; rds1; rds2; }
  { rank=same; cw; sm; vpce; }
  sns -> sm [style=invis];
}
